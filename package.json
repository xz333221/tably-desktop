{
  "name": "tably-desktop",
  "version": "0.1.0",
  "description": "A JSON-driven tablet-style web desktop with draggable apps, folders and custom widgets.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": { "types": "./dist/style.d.ts", "default": "./dist/style.css" }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --config vite.lib.config.ts && tsc --project tsconfig.build.json && node scripts/finalize-build.mjs",
    "build:demo": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:package": "node scripts/check-package.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  },
  "keywords": [
    "desktop",
    "tablet",
    "react",
    "widgets",
    "drag-and-drop",
    "json",
    "dashboard"
  ],
  "license": "MIT"
}
